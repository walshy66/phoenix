---
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorCard from '../components/SponsorCard.astro';
import sponsorsData from '../data/sponsors.json';
import { clubProfile, mailto } from '../config/club-profile';

const sponsorTiers = [
  { tier: 'Gold Sponsor', amount: 'Contact us', perks: ['Logo on jerseys', 'Major website presence', 'Social media shoutouts', 'Event recognition'], accent: '#8B7536' },
  { tier: 'Silver Sponsor', amount: 'Contact us', perks: ['Logo on team banner', 'Website listing', 'Social media mentions'], accent: '#573F93' },
  { tier: 'Bronze Sponsor', amount: 'Contact us', perks: ['Website listing', 'Acknowledgment in club communications'], accent: '#111111' },
];
---

<BaseLayout title="Get Involved" description={`Support ${clubProfile.shortName} Basketball through sponsorship and volunteering.`}>
  <section class="relative overflow-hidden bg-brand-purple px-4 py-12 text-center lg:py-8">
    <div class="mx-auto max-w-3xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-widest text-purple-200">Community</p>
      <h1 class="text-4xl font-black uppercase tracking-tight text-white sm:text-5xl">Get Involved</h1>
      <div class="mx-auto mt-4 h-1 w-16 bg-brand-gold"></div>
      <p class="mx-auto mt-4 max-w-xl text-base text-purple-100">Help our community thrive — sponsor the club or volunteer your time.</p>
    </div>
  </section>

  <section id="sponsors" class="bg-brand-offwhite px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h2 class="mb-2 text-2xl font-bold uppercase tracking-wide text-brand-purple">Sponsorship</h2>
      <div class="mb-4 h-1 w-12 bg-brand-gold"></div>
      <p class="mb-4 max-w-2xl text-gray-600">Sponsoring {clubProfile.name} is a great way to connect with the local community while supporting the growth of basketball in {clubProfile.location.region}.</p>
      <a href="/resources/sponsors/PHOENIX_SponsorProspectus_20251010.pdf" target="_blank" rel="noopener noreferrer" class="mb-8 inline-flex min-h-[44px] items-center gap-2 rounded-lg bg-brand-purple px-6 py-3 text-sm font-bold text-white transition-colors hover:bg-purple-800">Sponsor Prospectus<span class="sr-only"> (opens in a new tab)</span></a>
      <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-3">
        {sponsorTiers.map(tier => (
          <div class="card-hover overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm">
            <div class="h-2" style={`background-color: ${tier.accent};`}></div>
            <div class="p-6">
              <h3 class="mb-1 text-xl font-black text-brand-black">{tier.tier}</h3>
              <p class="mb-4 text-sm font-bold text-brand-purple">{tier.amount}</p>
              <ul class="space-y-2">{tier.perks.map(perk => (<li class="flex items-center gap-2 text-sm text-gray-600"><span class="font-bold text-brand-gold" aria-hidden="true">✓</span>{perk}</li>))}</ul>
              <a href={mailto(clubProfile.contact.generalEmail, 'Sponsorship Enquiry')} class="mt-6 block rounded-lg py-2.5 text-center text-sm font-bold text-white transition-colors" style={`background-color: ${tier.accent};`}>Get in Touch</a>
            </div>
          </div>
        ))}
      </div>
      <div class="rounded-xl border border-gray-100 bg-white p-6">
        <h3 class="mb-4 text-center text-sm font-bold uppercase tracking-widest text-brand-purple">OUR PROUD SPONSORS</h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
          {sponsorsData.sponsors.length > 0 ? (
            <SponsorCard sponsor={sponsorsData.sponsors[0]} layout="grid" isFirstSponsor />
          ) : (
            <div class="flex h-24 items-center justify-center rounded-lg border border-dashed border-gray-300 bg-gray-100"><span class="text-xs text-gray-400">your logo here</span></div>
          )}
          {Array.from({ length: 5 }).map(() => (<div class="flex h-24 items-center justify-center rounded-lg border border-dashed border-gray-300 bg-gray-100"><span class="text-xs text-gray-400">your logo here</span></div>))}
        </div>
      </div>
    </div>
  </section>

  <section id="volunteer-with-us" class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto max-w-3xl rounded-2xl bg-brand-purple p-8 text-center">
        <span class="mb-4 block text-5xl" aria-hidden="true">🙋</span>
        <h2 class="mb-3 text-2xl font-black uppercase tracking-wide text-white">Volunteer With Us</h2>
        <div class="mx-auto mb-5 h-1 w-12 bg-brand-gold"></div>
        <p class="mb-4 leading-relaxed text-purple-200">Our club relies on the generosity of volunteers to operate. Whether you can help with score-keeping, canteen duty, event organisation or social media — every contribution makes a difference.</p>
        <p class="mb-8 leading-relaxed text-purple-200">We welcome parents, community members and basketball enthusiasts of all backgrounds. No experience necessary — just a willingness to help!</p>
        <a href={mailto(clubProfile.contact.generalEmail, 'Volunteering Enquiry')} class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-lg bg-brand-gold px-8 py-4 text-base font-bold text-white transition-opacity hover:opacity-90">Express Your Interest</a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm"><img src="/uploads/volunteers_needed.png" alt="Heroes needed volunteer recruitment poster asking parents, siblings, players over 16, family and friends to help as coaches, team managers and committee members" loading="lazy" width="1400" height="780" class="h-auto w-full object-cover" /></div>
        <div class="overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm"><img src="/uploads/volunteers_child_safety.png" alt="Child safety requirements for volunteers" loading="lazy" width="1400" height="780" class="h-auto w-full object-cover" /></div>
      </div>
    </div>
  </section>
</BaseLayout>
