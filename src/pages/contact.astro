---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clubProfile, mailto } from '../config/club-profile';
---

<BaseLayout title="Contact" description={`General enquiries for ${clubProfile.name}. Get in touch about playing, volunteering or sponsorship.`}>
  <section class="bg-brand-purple px-4 py-12 text-center lg:py-8">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-4xl font-black uppercase tracking-tight text-white sm:text-5xl">Contact Us</h1>
      <div class="mx-auto mt-4 h-1 w-16 bg-brand-gold"></div>
      <p class="mt-4 text-base text-purple-100">We'd love to hear from you.</p>
    </div>
  </section>
  <section class="bg-brand-offwhite px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="enquiries-heading">
    <div class="mx-auto max-w-3xl rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-sm sm:p-12">
      <h2 id="enquiries-heading" class="mb-4 text-2xl font-black text-brand-purple">General Enquiries</h2>
      <p class="mx-auto mb-8 max-w-xl leading-relaxed text-gray-700">Have a question about joining Phoenix, volunteering, sponsorship or the club? Email our general enquiries inbox and we'll help you find the right information.</p>
      <a href={mailto(clubProfile.contact.generalEmail)} class="inline-flex min-h-[48px] max-w-full items-center justify-center rounded-lg bg-brand-purple px-4 py-3 font-bold text-white hover:bg-purple-800 sm:px-6"><span class="break-all">{clubProfile.contact.generalEmail}</span></a>
      <div class="mt-8 border-t border-gray-200 pt-6">
        <p class="text-sm leading-relaxed text-gray-600">For club news and seasonal announcements, visit <a href={clubProfile.socials.facebook.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-purple underline">Phoenix on Facebook<span class="sr-only"> (opens in a new tab)</span></a>. You can always email us if you don't use Facebook.</p>
      </div>
    </div>
  </section>
</BaseLayout>
