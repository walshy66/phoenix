---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Game Details">
  <section class="bg-brand-purple py-8 lg:py-6 px-4 text-center">
    <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Game Details</h1>
  </section>

  <section class="px-4 py-4 sm:px-6 lg:px-8">
    <div id="game-detail-root" class="mx-auto max-w-3xl">
      <p class="py-12 text-center text-gray-500">Loading game details&hellip;</p>
    </div>
  </section>

  <script>
    import { renderGameDetail } from '../../lib/playhq/round-renderer';

    const rootEl = document.getElementById('game-detail-root');

    function showNotFound() {
      rootEl.innerHTML = `
        <section class="py-12 px-4">
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
            <h2 class="text-xl font-bold text-brand-black mb-2">Game not found</h2>
            <p class="text-gray-600 text-sm mb-4">This game may be unavailable or no longer in the published dataset.</p>
            <a href="/scores" class="text-brand-purple font-bold hover:underline">View all scores</a>
          </div>
        </section>
      `;
    }

    async function loadGame() {
      const params = new URLSearchParams(window.location.search);
      const gameId = params.get('id');

      if (!gameId) {
        showNotFound();
        return;
      }

      try {
        const t = Date.now();
        const indexRes = await fetch(`/live-data/rounds/game-index.json?t=${t}`);
        if (!indexRes.ok) throw new Error('index unavailable');
        const index = await indexRes.json();

        const roundNumber = index.games?.[gameId];
        if (!roundNumber) {
          showNotFound();
          return;
        }

        const [roundRes, liveRes] = await Promise.all([
          fetch(`/live-data/rounds/round-${roundNumber}.json?t=${t}`),
          fetch(`/live-data/live-scores.json?t=${t}`).catch(() => null),
        ]);

        if (!roundRes.ok) throw new Error('round unavailable');
        const round = await roundRes.json();
        const liveScores = liveRes?.ok ? await liveRes.json() : {};

        const game = (round.games ?? []).find((g) => g.id === gameId);
        if (!game) {
          showNotFound();
          return;
        }

        rootEl.innerHTML = renderGameDetail(game, liveScores);
      } catch {
        rootEl.innerHTML = `
          <section class="py-12 px-4">
            <div class="rounded-xl border border-red-200 bg-red-50 p-6 text-center">
              <h2 class="text-xl font-bold text-brand-black mb-2">Could not load game</h2>
              <p class="text-gray-600 text-sm mb-4">Please try again or <a href="/scores" class="text-brand-purple font-bold hover:underline">view all scores</a>.</p>
            </div>
          </section>
        `;
      }
    }

    loadGame();
  </script>
</BaseLayout>
