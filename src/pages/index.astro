---
import BaseLayout from '../layouts/BaseLayout.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import { clubProfile } from '../config/club-profile';

const quickLinks = [
  { title: 'Play Basketball', href: '/play-basketball', icon: '🏀', desc: 'Find your place at Phoenix and learn how to join.' },
  { title: 'Get Involved', href: '/get-involved', icon: '🙌', desc: 'Support community basketball through sponsorship or volunteering.' },
  { title: 'Resources', href: '/resources/', icon: '📋', desc: 'Explore coaching drills, player guides and practical tools.' },
  { title: 'About Our Club', href: '/about', icon: '💜', desc: 'Discover our story, values and community.' },
];
---

<BaseLayout title="Home">
  <section class="welcome-hero px-4 py-16 sm:px-6 lg:px-8 lg:py-24" aria-labelledby="welcome-heading">
    <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="mb-4 text-sm font-bold uppercase tracking-widest text-purple-200">{clubProfile.name}</p>
        <h1 id="welcome-heading" class="max-w-3xl text-4xl font-black leading-tight text-white sm:text-5xl lg:text-6xl">Where Community<br /> Meets Competition</h1>
        <div class="my-6 h-1 w-20 bg-brand-gold"></div>
        <p class="max-w-xl text-lg leading-relaxed text-purple-100">Basketball brings us together. Be part of a welcoming club in {clubProfile.location.city} where players can build skills, make friends and enjoy the game.</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/play-basketball" class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-white px-6 py-3 font-bold text-brand-purple hover:bg-purple-100">Play Basketball</a>
          <a href="/get-involved" class="inline-flex min-h-[48px] items-center justify-center rounded-lg border-2 border-white px-6 py-3 font-bold text-white hover:bg-white/10">Get Involved</a>
        </div>
      </div>
      <!-- Permanent branded fallback until a suitable club photo is selected. -->
      <div class="flex items-center justify-center rounded-3xl border border-white/20 bg-white/5 p-8 sm:p-12">
        <img src="/images/phoenix-united-logo.png" alt="Phoenix United Basketball" width="1328" height="2088" class="h-auto w-full max-w-80 object-contain" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="bg-brand-offwhite px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="explore-heading">
    <div class="mx-auto max-w-7xl">
      <h2 id="explore-heading" class="mb-2 text-2xl font-bold uppercase tracking-wide text-brand-purple">Explore Phoenix</h2>
      <div class="mb-8 h-1 w-12 bg-brand-gold"></div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {quickLinks.map(link => (
          <a href={link.href} class="card-hover group flex flex-col items-start gap-3 rounded-xl bg-brand-purple p-6">
            <span class="text-3xl" aria-hidden="true">{link.icon}</span>
            <h3 class="text-lg font-bold text-white">{link.title}</h3>
            <p class="text-sm leading-relaxed text-purple-100">{link.desc}</p>
            <span class="mt-auto pt-2 text-sm font-bold text-white">Explore <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <SponsorStrip />
</BaseLayout>

<style>
  .welcome-hero { background: radial-gradient(ellipse at top right, #7959b6 0%, #573f93 40%, #271745 100%); }
</style>
