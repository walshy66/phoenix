---
import BaseLayout from '../layouts/BaseLayout.astro'
import SeasonTile from '../components/SeasonTile.astro'
import SeasonInfoModal from '../components/SeasonInfoModal.astro'
import { SEASON_CARDS, SUMMER_2026_27_ENQUIRY_MODAL_ID } from '../lib/seasons/constants'
import { VENUES } from '../data/venues'
import { SEASON_INFO_CARDS } from '../data/season-info'
import { clubProfile, mailto } from '../config/club-profile'

const isGradingActive = false
const seasonInfoCards = Array.isArray(SEASON_INFO_CARDS) ? SEASON_INFO_CARDS : []
const registrationEnquirySubject = 'Summer 2026/27 Registration Enquiry'
const registrationEnquiryBody = [
  'Player name:',
  'Date of birth:',
  'Current/previous Phoenix team or connection:',
  'Team they are enquiring about:',
  'Any other notes:',
].join('\n\n')
const registrationEnquiryMailto = `mailto:${clubProfile.contact.generalEmail}?subject=${encodeURIComponent(registrationEnquirySubject)}&body=${encodeURIComponent(registrationEnquiryBody)}`
const continuingAndNewTeams = [
  'Phoenix Possums (NEW U8 mixed)',
  'Phoenix Go Getters',
  'Phoenix Flames',
  'Phoenix Thunder',
  'Phoenix Firebirds (U12 girls)',
  'Phoenix Gold Nuggets',
  'Phoenix Sweats (U14 boys)',
  'Phoenix Phantoms',
  'Phoenix Diamonds (U14 girls)',
  'Phoenix Stars',
  'Phoenix NEW U16 (formerly Zinger Boxes)',
  'Phoenix Gooney Tunes',
  'Phoenix Flyers',
  'Phoenix Two Blues',
  'Phoenix Tulips',
  'Phoenix NEW U16 Girls (formerly Diamonds)',
  'Phoenix Zinger Boxes',
  'Phoenix Go Buckets',
  'Phoenix Splash',
]
const teamsStillBeingFinalised = ['U10 Girls', 'U10 Boys', 'U16 Boys']
const getInfoCard = (id: (typeof seasonInfoCards)[number]['id']) => seasonInfoCards.find((card) => card.id === id)
const uniformsCard = getInfoCard('uniforms')
const clearancesCard = getInfoCard('clearances')
const registrationCard = getInfoCard('registration')
const registrationFeesCard = registrationCard?.subCards.find((subCard) => subCard.id === 'registration-fees')
const uniformNumbersCard = uniformsCard?.subCards.find((subCard) => subCard.id === 'uniform-numbers')
const uniformLoanCard = uniformsCard?.subCards.find((subCard) => subCard.id === 'uniform-loan')
const uniformSecondHandCard = uniformsCard?.subCards.find((subCard) => subCard.id === 'uniform-2nd-hand')
const clearancePortalCard = clearancesCard?.subCards.find((subCard) => subCard.id === 'clearance-portal')
const uniformOrderingUrl = 'https://www.stepinsports.com.au/product-category/phoenix-basketball/'
---

<BaseLayout title="Seasons" description={`${clubProfile.shortName} Basketball season draw, costs, registration and grading information.`}>
  <section class="relative overflow-hidden bg-brand-purple px-4 py-12 lg:py-8 text-center">
    <div class="pointer-events-none absolute inset-0 opacity-10">
      <div class="absolute -right-16 -top-16 h-64 w-64 rounded-full" style="background: #8B7536;"></div>
      <div class="absolute -bottom-16 -left-16 h-48 w-48 rounded-full" style="background: #8B7536;"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-3xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-widest text-brand-gold">{clubProfile.shortName}</p>
      <h1 class="text-4xl font-black uppercase tracking-tight text-white sm:text-5xl">SEASONS</h1>
      <div class="mx-auto mt-4 h-1 w-16 bg-brand-gold"></div>
      <p class="mx-auto mt-4 max-w-xl text-base text-purple-200">
        Find out everything you need to know about the current season — draw, registration, costs and grading.
      </p>
    </div>
  </section>

  {seasonInfoCards.length > 0 && (
    <section aria-labelledby="season-info-heading" class="bg-brand-offwhite px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <p class="mb-2 text-sm font-bold uppercase tracking-widest text-brand-gold">Current & upcoming seasons</p>
        <h2 id="season-info-heading" class="mb-2 text-2xl font-bold uppercase tracking-wide text-brand-purple">
          Season Information
        </h2>
        <div class="mb-8 h-1 w-12 bg-brand-gold"></div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2" aria-label="Season action panels">
          <article class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="mb-5 flex items-start justify-between gap-4">
              <div>
                <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Current season</p>
                <h3 class="text-2xl font-black text-brand-purple">Winter 2026</h3>
              </div>
              <span class="rounded-full bg-brand-purple px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">Live</span>
            </div>
            <p class="mb-6 flex-1 text-sm leading-relaxed text-gray-600">
              Winter 2026 is underway. Find your team, confirm training details, and follow scores and results from one place.
            </p>
            <div class="grid gap-3 sm:grid-cols-3">
              <a href="/teams" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-brand-purple px-4 py-3 text-center text-sm font-bold text-white transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                View Teams
              </a>
              <a href="#training" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-4 py-3 text-center text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                Training
              </a>
              <a href="/scores" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-4 py-3 text-center text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                Scores & Results
              </a>
            </div>
          </article>

          <article class="flex h-full flex-col rounded-xl border-2 border-brand-gold bg-white p-6 shadow-sm">
            <div class="mb-5 flex items-start justify-between gap-4">
              <div>
                <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Next season</p>
                <h3 class="text-2xl font-black text-brand-purple">Summer 2026/27</h3>
              </div>
              <span class="rounded-full bg-brand-gold px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-black">Enquire first</span>
            </div>
            <p class="mb-6 flex-1 text-sm leading-relaxed text-gray-600">
              Summer team places are limited. Please enquire before registering so Phoenix can confirm the right team pathway.
            </p>
            <div class="grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                data-registration-enquiry-trigger
                data-registration-enquiry-modal-id={SUMMER_2026_27_ENQUIRY_MODAL_ID}
                class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-brand-purple px-4 py-3 text-center text-sm font-bold text-white transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2"
              >
                Registration Enquiry
              </button>
              <a href="#summer-checklist" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-4 py-3 text-center text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                Summer Checklist
              </a>
            </div>
          </article>
        </div>

        <div id="summer-checklist" class="mt-10 scroll-mt-24">
          <h3 class="mb-2 text-xl font-black uppercase tracking-wide text-brand-purple">Summer 2026/27 Checklist</h3>
          <p class="mb-6 max-w-3xl text-sm leading-relaxed text-gray-600">
            Work through these steps before the season starts. Existing documents still open in their established modal or enlarge behaviour.
          </p>
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
              <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Step 1</p>
              <h4 class="mb-2 text-lg font-bold text-brand-purple">Registration enquiry</h4>
              <p class="mb-4 text-sm leading-relaxed text-gray-600">Email Phoenix first so we can confirm team availability before any private registration link is issued.</p>
              <button
                type="button"
                data-registration-enquiry-trigger
                data-registration-enquiry-modal-id={SUMMER_2026_27_ENQUIRY_MODAL_ID}
                class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-brand-purple px-5 py-3 text-sm font-bold text-white transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2"
              >
                Open enquiry popup
              </button>
            </article>

            {registrationFeesCard && (
              <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Step 2</p>
                <h4 class="mb-2 text-lg font-bold text-brand-purple">Fees</h4>
                <p class="mb-4 text-sm leading-relaxed text-gray-600">Review the Summer 2026/27 fee schedule.</p>
                <button
                  type="button"
                  data-infographic-zoom-trigger
                  data-zoom-src={registrationFeesCard.imageSrc}
                  data-zoom-alt={registrationFeesCard.imageAlt}
                  class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-5 py-3 text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2"
                >
                  Enlarge fees
                </button>
              </article>
            )}

            <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
              <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Step 3</p>
              <h4 class="mb-2 text-lg font-bold text-brand-purple">Uniforms</h4>
              <p class="mb-4 text-sm leading-relaxed text-gray-600">Order new gear, check number guidance, ask about the loan program, or browse second-hand options.</p>
              <div class="grid gap-3 sm:grid-cols-2">
                <a href={uniformOrderingUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-brand-purple px-4 py-3 text-center text-sm font-bold text-white transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                  Ordering
                </a>
                {uniformNumbersCard && (
                  <button type="button" data-infographic-zoom-trigger data-zoom-src={uniformNumbersCard.imageSrc} data-zoom-alt={uniformNumbersCard.imageAlt} class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-4 py-3 text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                    Numbers
                  </button>
                )}
                {uniformLoanCard && (
                  <button type="button" data-infographic-zoom-trigger data-zoom-src={uniformLoanCard.imageSrc} data-zoom-alt={uniformLoanCard.imageAlt} class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-4 py-3 text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                    Loan Program
                  </button>
                )}
                {uniformSecondHandCard?.linkUrl && (
                  <a href={uniformSecondHandCard.linkUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-4 py-3 text-center text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                    Second-hand
                  </a>
                )}
              </div>
            </article>

            {clearancePortalCard?.linkUrl && (
              <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
                <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Step 4</p>
                <h4 class="mb-2 text-lg font-bold text-brand-purple">Clearances</h4>
                <p class="mb-4 text-sm leading-relaxed text-gray-600">If you are moving from another club, complete the existing Basketball Victoria clearance form.</p>
                <a href={clearancePortalCard.linkUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-5 py-3 text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                  Submit clearance
                </a>
              </article>
            )}

            <article id="training" class="scroll-mt-24 rounded-xl border border-gray-200 bg-white p-5 shadow-sm lg:col-span-2">
              <p class="mb-2 text-xs font-bold uppercase tracking-wide text-brand-gold">Step 5</p>
              <h4 class="mb-2 text-lg font-bold text-brand-purple">Training</h4>
              <p class="text-sm leading-relaxed text-gray-600">Winter training details are available through the Training information modal. Summer 2026/27 training will be confirmed closer to season start.</p>
              {getInfoCard('training') && (
                <button type="button" data-modal-id="training" class="mt-4 inline-flex min-h-[44px] items-center justify-center rounded-lg border border-brand-purple px-5 py-3 text-sm font-bold text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2">
                  View training information
                </button>
              )}
            </article>
          </div>
        </div>
      </div>
    </section>
  )}

  {seasonInfoCards.map((card) => (
    <SeasonInfoModal card={card} venues={card.id === 'training' ? VENUES : []} />
  ))}

  <div
    id={SUMMER_2026_27_ENQUIRY_MODAL_ID}
    class="fixed inset-0 z-[80] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="registration-enquiry-title"
    data-open="false"
  >
    <div class="absolute inset-0 bg-black/40" aria-hidden="true" data-modal-backdrop></div>
    <div class="relative z-10 flex h-full w-full items-center justify-center md:p-4">
      <div class="flex h-full w-full flex-col overflow-hidden bg-brand-offwhite md:h-auto md:max-h-[90vh] md:w-[95vw] md:max-w-4xl md:rounded-xl md:shadow-xl">
        <header class="flex items-center justify-between gap-3 border-b border-gray-200 bg-white px-4 py-3 md:px-6">
          <h2 id="registration-enquiry-title" class="text-lg font-black uppercase tracking-tight text-brand-black md:text-xl">
            Summer 2026/27 Registration Enquiry
          </h2>
          <button
            type="button"
            data-close-btn
            aria-label="Close Summer 2026/27 registration enquiry"
            class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-brand-purple transition-colors hover:bg-purple-50 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </header>

        <div class="overflow-y-auto p-4 md:p-6">
          <div class="mb-6 rounded-lg border-2 border-brand-gold bg-yellow-50 p-4 text-sm leading-relaxed text-gray-700">
            <p class="mb-3">
              Places are limited across Summer 2026/27 teams. Please enquire before registering so the club can confirm whether there is an appropriate team place available.
            </p>
            <p>
              If the club sends you a private registration link, please do not share it with other families. Shared links can result in registrations being submitted for teams that are already full or still being finalised.
            </p>
          </div>

          <div class="grid gap-6 lg:grid-cols-[1fr_0.75fr]">
            <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
              <h3 class="mb-4 text-base font-bold text-brand-purple">Continuing & New Teams</h3>
              <ul class="grid gap-2 text-sm text-gray-700 sm:grid-cols-2">
                {continuingAndNewTeams.map((team) => (
                  <li class="rounded-md bg-brand-offwhite/60 px-3 py-2">{team}</li>
                ))}
              </ul>
            </div>

            <div class="space-y-6">
              <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
                <h3 class="mb-4 text-base font-bold text-brand-purple">Teams Still Being Finalised</h3>
                <ul class="space-y-2 text-sm text-gray-700">
                  {teamsStillBeingFinalised.map((team) => (
                    <li class="rounded-md bg-brand-offwhite/60 px-3 py-2">{team}</li>
                  ))}
                </ul>
              </div>

              <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
                <h3 class="mb-2 text-base font-bold text-brand-black">What to include in your email</h3>
                <ul class="mb-5 space-y-2 text-sm text-gray-700">
                  <li>Player name</li>
                  <li>Date of birth</li>
                  <li>Current/previous Phoenix team or connection</li>
                  <li>Team they are enquiring about</li>
                  <li>Any other notes</li>
                </ul>
                <a
                  href={registrationEnquiryMailto}
                  class="inline-flex min-h-[44px] w-full items-center justify-center rounded-lg bg-brand-purple px-6 py-3 text-center text-sm font-bold text-white transition-opacity hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-brand-purple focus:ring-offset-2"
                >
                  Email {clubProfile.contact.generalEmail}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2" id="seasons-grid">
        {SEASON_CARDS.map((season) => <SeasonTile season={season} />)}
      </div>
    </div>
  </section>

  <section class="bg-white px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex items-start gap-4 rounded-xl border-2 border-brand-gold bg-yellow-50 p-5">
        <span class="text-3xl">🤝</span>
        <div>
          <h3 class="mb-1 text-base font-bold text-brand-black">Need Financial Assistance?</h3>
          <p class="text-sm leading-relaxed text-gray-600">
            Our <a href="/about#slam-dunk" class="font-semibold text-brand-purple underline hover:text-brand-gold">Slam Dunk Bridging Fund</a> is here to ensure no player misses out.
            Contact us confidentially at <a href={mailto(clubProfile.contact.generalEmail)} class="font-semibold text-brand-purple hover:text-brand-gold">{clubProfile.contact.generalEmail}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  {isGradingActive && (
    <section class="bg-brand-offwhite px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <h2 class="mb-2 text-2xl font-bold uppercase tracking-wide text-brand-purple">Grading Information</h2>
        <div class="mb-8 h-1 w-12 bg-brand-gold"></div>

        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <div>
            <p class="mb-4 leading-relaxed text-gray-600">
              Grading sessions are used to place players in the most appropriate competition grade to ensure
              the best possible experience for all participants.
            </p>
            <p class="mb-4 leading-relaxed text-gray-600">
              All new players are required to attend a grading session. Returning players may be placed in grades
              based on their previous season's performance.
            </p>
            <p class="leading-relaxed text-gray-600">
              Grading dates will be announced closer to the season start. Watch our social media and check back here for updates.
            </p>
          </div>
          <div class="rounded-xl border border-gray-100 bg-white p-6">
            <h3 class="mb-4 text-base font-bold text-brand-purple">What to Bring to Grading</h3>
            <ul class="space-y-3">
              {[
                'Basketball shoes and appropriate sports clothing',
                'Water bottle',
                'Completed registration form',
                'Any previous season stats or team info if available',
              ].map((item) => (
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="mt-0.5 font-bold text-brand-gold">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <div
    id="infographic-zoom-overlay"
    class="fixed inset-0 z-[90] hidden"
    role="dialog"
    aria-modal="true"
    aria-label="Expanded infographic"
    data-open="false"
  >
    <div class="absolute inset-0 bg-black/60" data-infographic-zoom-backdrop></div>
    <div class="relative z-10 flex h-full w-full items-center justify-center p-4">
      <div class="relative max-h-[92vh] max-w-[95vw] overflow-auto rounded-xl bg-white p-2 shadow-2xl">
        <button
          type="button"
          data-infographic-zoom-close
          aria-label="Close expanded infographic"
          class="absolute right-2 top-2 inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md bg-white/90 text-brand-purple shadow hover:bg-white focus:outline-none focus:ring-2 focus:ring-brand-purple"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <img id="infographic-zoom-image" src="" alt="" class="h-auto max-h-[88vh] w-auto max-w-[92vw] object-contain" />
      </div>
    </div>
  </div>

  <script>
    (function () {
      const FOCUSABLE = 'button:not([disabled]), [href], [tabindex]:not([tabindex="-1"])';
      let triggerEl: HTMLElement | null = null;
      let openModalEl: HTMLElement | null = null;
      let zoomTriggerEl: HTMLElement | null = null;

      const zoomOverlayEl = document.getElementById('infographic-zoom-overlay');
      const zoomImageEl = document.getElementById('infographic-zoom-image') as HTMLImageElement | null;

      function getModal(id: string): HTMLElement | null {
        return document.getElementById(`season-info-modal-${id}`);
      }

      function getRegistrationEnquiryModal(id: string | undefined): HTMLElement | null {
        if (!id) return null;
        return document.getElementById(id);
      }

      function isZoomOpen() {
        return zoomOverlayEl?.getAttribute('data-open') === 'true';
      }

      function openZoom(src: string, alt: string, trigger: HTMLElement) {
        if (!zoomOverlayEl || !zoomImageEl) return;
        zoomTriggerEl = trigger;
        zoomImageEl.src = src;
        zoomImageEl.alt = alt || 'Expanded infographic';
        zoomOverlayEl.classList.remove('hidden');
        zoomOverlayEl.setAttribute('data-open', 'true');
        const closeBtn = zoomOverlayEl.querySelector<HTMLElement>('[data-infographic-zoom-close]');
        requestAnimationFrame(() => closeBtn?.focus());
      }

      function closeZoom(restoreFocus = true) {
        if (!zoomOverlayEl || !zoomImageEl) return;
        zoomOverlayEl.classList.add('hidden');
        zoomOverlayEl.setAttribute('data-open', 'false');
        zoomImageEl.src = '';
        zoomImageEl.alt = '';
        if (restoreFocus && zoomTriggerEl) zoomTriggerEl.focus();
        zoomTriggerEl = null;
      }

      function closeModal(modal: HTMLElement) {
        if (isZoomOpen()) {
          closeZoom(false);
        }
        modal.classList.add('hidden');
        modal.setAttribute('data-open', 'false');
        document.body.classList.remove('overflow-hidden');
        if (triggerEl) triggerEl.focus();
        openModalEl = null;
        triggerEl = null;
      }

      function openModal(modal: HTMLElement, trigger: HTMLElement) {
        if (openModalEl && openModalEl !== modal) {
          closeModal(openModalEl);
        }
        if (modal.dataset.open === 'true') return;

        triggerEl = trigger;
        openModalEl = modal;
        modal.classList.remove('hidden');
        modal.setAttribute('data-open', 'true');
        document.body.classList.add('overflow-hidden');

        const closeBtn = modal.querySelector<HTMLElement>('[data-close-btn]');
        requestAnimationFrame(() => closeBtn?.focus());
      }

      function trapFocus(event: KeyboardEvent, modal: HTMLElement) {
        if (event.key !== 'Tab') return;
        const nodes = Array.from(modal.querySelectorAll<HTMLElement>(FOCUSABLE));
        if (!nodes.length) return;
        const first = nodes[0];
        const last = nodes[nodes.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }

      // Wire each card button
      document.querySelectorAll<HTMLButtonElement>('[data-modal-id]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const modal = getModal(btn.dataset.modalId!);
          if (modal) openModal(modal, btn);
        });
      });

      // Wire Summer registration enquiry buttons
      document.querySelectorAll<HTMLElement>('[data-registration-enquiry-trigger]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const modal = getRegistrationEnquiryModal(btn.dataset.registrationEnquiryModalId);
          if (modal) openModal(modal, btn);
        });
      });

      // Wire close buttons and backdrops
      document.querySelectorAll<HTMLElement>('[data-close-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const modal = btn.closest<HTMLElement>('[role="dialog"]');
          if (modal) closeModal(modal);
        });
      });

      // Zoomable infographic triggers (non-link infographics only)
      document.querySelectorAll<HTMLElement>('[data-infographic-zoom-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const src = trigger.dataset.zoomSrc;
          const alt = trigger.dataset.zoomAlt || 'Expanded infographic';
          if (src) openZoom(src, alt, trigger);
        });
      });

      zoomOverlayEl?.querySelector<HTMLElement>('[data-infographic-zoom-close]')?.addEventListener('click', () => {
        closeZoom();
      });

      zoomOverlayEl?.querySelector<HTMLElement>('[data-infographic-zoom-backdrop]')?.addEventListener('click', () => {
        closeZoom();
      });

      document.querySelectorAll<HTMLElement>('[data-modal-backdrop]').forEach((backdrop) => {
        backdrop.addEventListener('click', () => {
          const modal = backdrop.closest<HTMLElement>('[role="dialog"]');
          if (modal) closeModal(modal);
        });
      });

      // Global keyboard handler
      document.addEventListener('keydown', (event) => {
        if (isZoomOpen() && zoomOverlayEl) {
          if (event.key === 'Escape') {
            event.preventDefault();
            closeZoom();
            return;
          }
          trapFocus(event, zoomOverlayEl);
          return;
        }

        if (!openModalEl) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeModal(openModalEl);
          return;
        }
        trapFocus(event, openModalEl);
      });
    })();
  </script>

</BaseLayout>
