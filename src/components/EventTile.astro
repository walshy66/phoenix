---
interface Props {
  id: string;
  title: string;
  date: string;
  image: string;
  alt?: string;
  time?: string;
  location?: string;
  description?: string;
  category?: string;
  featured?: boolean;
}

const { id, title, date, image, alt, time, location, description, category, featured = false } = Astro.props;

// Format date for display
const formattedDate = new Date(date).toLocaleDateString('en-AU', {
  weekday: 'short',
  day: 'numeric',
  month: 'short'
});

const formattedTime = time || null;

// Check if this is a month-based event (title is like "Month Year")
const monthPattern = /^(January|February|March|April|May|June|July|August|September|October|November|December) \d{4}$/;
const isMonthEvent = monthPattern.test(title);
const displayCategory = category || (isMonthEvent ? 'Month' : 'Event');

// Serialize event data for the modal
const eventData = JSON.stringify({ id, title, date, image, alt, time, location, description, category });
---

<div
  class:list={[
    'event-tile bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 flex flex-col transition-shadow duration-200',
    featured ? '' : 'hover:shadow-md cursor-pointer'
  ]}
  tabindex={featured ? undefined : '0'}
  role={featured ? undefined : 'button'}
  aria-label={featured ? undefined : `View details for ${title}`}
  data-event={featured ? undefined : eventData}
>
  <!-- Image -->
  <div class:list={['relative', featured ? 'h-auto' : 'h-48']}>
    <img
      src={image}
      alt={alt || `${title} — ${date}`}
      class:list={['w-full', featured ? 'h-auto object-contain' : 'h-full object-cover']}
      onerror="this.onerror=null; this.src='/images/placeholder-event.jpg';"
    >
  </div>

  <!-- Content -->
  {!featured && (
    <div class="p-5 flex flex-col flex-1">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-brand-offwhite text-brand-purple border border-brand-purple">
          {displayCategory}
        </span>
        <span class="text-xs text-gray-400 font-medium">{formattedDate}{formattedTime ? ` • ${formattedTime}` : ''}</span>
      </div>
      <h3 class="font-bold text-brand-black text-base mb-2 line-clamp-2">{title}</h3>
      {description && (
        <p class="text-gray-500 text-sm leading-relaxed flex-1 line-clamp-2">{description}</p>
      )}
    </div>
  )}
</div>
