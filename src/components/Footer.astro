---
import { clubProfile, mailto } from '../config/club-profile';

const currentYear = new Date().getFullYear();
const fallbackInitials = clubProfile.shortName
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<footer class="bg-brand-purple text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Brand -->
      <div>
        <div class="mb-4">
          <img
            src="/images/logos/phoenix-logo.png"
            alt={clubProfile.name}
            class="h-20 w-auto"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="hidden w-20 h-20 rounded-full bg-brand-gold flex items-center justify-center flex-shrink-0 text-white font-bold text-2xl leading-none">
            {fallbackInitials}
          </div>
        </div>
        <p class="text-purple-200 text-sm leading-relaxed">
          {clubProfile.tagline}. Proudly serving basketball in {clubProfile.location.city}.
        </p>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-brand-gold font-bold text-sm uppercase tracking-wider mb-4">Contact Us</h3>
        <address class="not-italic space-y-2 text-sm text-purple-200">
          <p class="flex items-start gap-2">
            <span class="mt-0.5">📍</span>
            <span>
              {clubProfile.contact.postalAddress.map((line, index) => (
                <>{line}{index < clubProfile.contact.postalAddress.length - 1 && <br />}</>
              ))}
            </span>
          </p>
          <p class="flex items-center gap-2">
            <span>✉️</span>
            <a
              href={mailto(clubProfile.contact.generalEmail)}
              class="hover:text-brand-gold transition-colors duration-150"
            >
              {clubProfile.contact.generalEmail}
            </a>
          </p>
        </address>
      </div>

      <!-- Follow Us -->
      <div>
        <h3 class="text-brand-gold font-bold text-sm uppercase tracking-wider mb-4">Follow Us</h3>
        <div class="space-y-2">
          <a
            href={clubProfile.socials.facebook.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-purple-200 hover:text-brand-gold transition-colors duration-150"
          >
            <span>📘</span> {clubProfile.socials.facebook.label}
          </a>
          <a
            href={clubProfile.socials.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-purple-200 hover:text-brand-gold transition-colors duration-150"
          >
            <span>📷</span> {clubProfile.socials.instagram.label}
          </a>
        </div>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-brand-gold font-bold text-sm uppercase tracking-wider mb-4">Newsletter</h3>
        <script async src="https://eomail5.com/form/11c550ac-11dc-11f1-a2e0-ef681a07d4a5.js" data-form="11c550ac-11dc-11f1-a2e0-ef681a07d4a5"></script>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-purple-700 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-purple-300 text-xs">
        &copy; {clubProfile.legalName} 2003 - {currentYear} All rights reserved.
      </p>
      <p class="text-purple-400 text-xs">
        <a
          href="https://bendigobasketball.com.au/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-brand-gold transition-colors"
        >
          compete in the Bendigo Basketball Association
        </a>
      </p>
    </div>
  </div>
</footer>
