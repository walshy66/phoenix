RewriteEngine On

# Preserve the canonical homepage and useful legacy newsletter links.
RewriteCond %{HTTP_HOST} ^www\.bendigophoenix\.org\.au$ [NC]
RewriteRule ^$ https://bendigophoenix.org.au/ [R=301,L]

# More-specific legacy routes precede the retired season/team/score routes.
RewriteRule ^team/players/?$ /resources/?tab=players [R=301,L]
RewriteRule ^get-involved/volunteers/?$ /get-involved/#volunteer-with-us [R=301,L,NE,QSD]
RewriteRule ^about/club-policies/?$ /resources/?tab=policies [R=301,L]

# Includes unknown team slugs and old game IDs. Drop obsolete query parameters.
RewriteRule ^(?:seasons|teams|team|scores)(?:/.*)?$ /play-basketball [R=301,L,NE,QSD]
